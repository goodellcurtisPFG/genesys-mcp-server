# Genesys Cloud OAuth Client Credentials grant.
# Create this in Genesys Cloud Admin > Integrations > OAuth > Add Client.
# Grant type: Client Credentials. Assign a READ-ONLY custom role (view-only
# permissions) — this server should never be given write scopes.
GENESYS_CLIENT_ID=your-oauth-client-id
GENESYS_CLIENT_SECRET=your-oauth-client-secret

# The domain suffix for your Genesys Cloud org's region, e.g.:
#   mypurecloud.com        (US East)
#   usw2.pure.cloud        (US West 2)
#   mypurecloud.ie         (EU West / Dublin)
#   mypurecloud.de         (EU Central / Frankfurt)
#   mypurecloud.com.au     (AU)
#   mypurecloud.jp         (Japan)
# Find yours under Admin > Organization Settings, or in the URL you use to log in.
GENESYS_ENVIRONMENT=mypurecloud.com
